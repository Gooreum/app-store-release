# app-store-release — App Store 앱 정보·스크린샷.
#
# 빌드 업로드는 여기서 하지 않는다 — scripts/app-store/archive-upload.sh가 한다.
# 이 레인은 fastlane/metadata·fastlane/screenshots를 App Store Connect에 맞춘다.
# 심사 제출은 사람이 한다.
#
# 키는 환경변수로 받는다: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH(.p8 파일 경로)
#
#   fastlane metadata                    앱 정보만
#   fastlane metadata screenshots:true   스크린샷까지 교체
#   fastlane metadata version:1.0.4      그 버전에 반영 (없으면 App Store Connect에 새로 만든다)
#   fastlane pull_metadata               App Store Connect 값을 fastlane/metadata로 내려받기
require "json"

CONFIG = JSON.parse(File.read(File.expand_path("../.app-store-release.json", __dir__)))
PLATFORM = CONFIG.fetch("platform") # "ios" | "osx"
APP_ID = CONFIG.fetch("app_identifier")

lane :metadata do |options|
  api_key
  deliver(
    platform: PLATFORM,
    app_identifier: APP_ID,
    app_version: options[:version],
    skip_binary_upload: true,
    skip_screenshots: options[:screenshots].to_s != "true",
    overwrite_screenshots: true,
    submit_for_review: false,
    # CI라 HTML 미리보기 확인을 띄울 사람이 없다
    force: true,
    run_precheck_before_submit: false
  )
end

# `fastlane deliver download_metadata`는 API 키를 JSON 본문으로만 받는다.
# 키 파일 내용을 다른 파일로 옮기지 않으려고 같은 일을 레인 안에서 한다.
lane :pull_metadata do
  api_key
  require "deliver"
  require "deliver/setup"
  options = FastlaneCore::Configuration.create(Deliver::Options.available_options, {
    platform: PLATFORM, app_identifier: APP_ID, force: true,
    api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
  })
  Deliver::Runner.new(options)
  app = Deliver.cache[:app]
  platform = PLATFORM == "osx" ? Spaceship::ConnectAPI::Platform::MAC_OS : Spaceship::ConnectAPI::Platform::IOS
  version = app.get_latest_app_store_version(platform: platform)
  Deliver::Setup.new.generate_metadata_files(app, version, File.expand_path("metadata", __dir__), options)
end

private_lane :api_key do
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH")
  )
end
